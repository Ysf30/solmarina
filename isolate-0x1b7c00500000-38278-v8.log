script-source,4,,\n  (function() {\n    const bindingName = "cdp";\n    const binding = window[bindingName];\n    delete window[bindingName];\n    if (window.self === window.top) {\n      window[bindingName] = {\n        onmessage: () => {}\x2C\n        send: binding\n      };\n    }\n  })();\n
