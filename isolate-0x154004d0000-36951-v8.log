script-source,17,chrome://resources/mojo/mojo/public/mojom/base/string16_converter.js,export class String16Converter{data(str){const arr=[];for(let i=0;i<str.length;++i){arr.push(str.charCodeAt(i))}return arr}convert(view){const data=view.data;return this.convertImpl(data)}convertImpl(data){const CHUNK_SIZE=8192;if(data.length<CHUNK_SIZE){return String.fromCharCode(...data)}let str="";for(let i=0;i<data.length;i+=CHUNK_SIZE){const chunk=data.slice(i\x2Ci+CHUNK_SIZE);str+=String.fromCharCode(...chunk)}return str}}
