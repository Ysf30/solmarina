script-source,7,chrome://resources/js/load_time_data.js,// Copyright 2022 The Chromium Authors\n// Use of this source code is governed by a BSD-style license that can be\n// found in the LICENSE file.\nimport{assert}from"./assert.js";class LoadTimeData{data_=null;set data(value){assert(!this.data_\x2C"Re-setting data.");this.data_=value}valueExists(id){assert(this.data_\x2C"No data. Did you remember to include strings.js?");return id in this.data_}getValue(id){assert(this.data_\x2C"No data. Did you remember to include strings.js?");const value=this.data_[id];assert(typeof value!=="undefined"\x2C"Could not find value for "+id);return value}getString(id){const value=this.getValue(id);assert(typeof value==="string"\x2C`[${value}] (${id}) is not a string`);return value}getStringF(id\x2C...args){const value=this.getString(id);if(!value){return""}return this.substituteString(value\x2C...args)}substituteString(label\x2C...args){return label.replace(/\\$(.|$|\\n)/g\x2C(function(m){assert(m.match(/\\$[$1-9]/)\x2C"Unescaped $ found in localized string.");if(m==="$$"){return"$"}const substitute=args[Number(m[1])-1];if(substitute===undefined||substitute===null){return""}return substitute.toString()}))}getSubstitutedStringPieces(label\x2C...args){const pieces=(label.match(/(\\$[1-9])|(([^$]|\\$([^1-9]|$))+)/g)||[]).map((function(p){if(!p.match(/^\\$[1-9]$/)){assert((p.match(/\\$/g)||[]).length%2===0\x2C"Unescaped $ found in localized string.");return{value:p.replace(/\\$\\$/g\x2C"$")\x2Carg:null}}const substitute=args[Number(p[1])-1];if(substitute===undefined||substitute===null){return{value:""\x2Carg:p}}return{value:substitute.toString()\x2Carg:p}}));return pieces}getBoolean(id){const value=this.getValue(id);assert(typeof value==="boolean"\x2C`[${value}] (${id}) is not a boolean`);return value}getInteger(id){const value=this.getValue(id);assert(typeof value==="number"\x2C`[${value}] (${id}) is not a number`);assert(value===Math.floor(value)\x2C"Number isn't integer: "+value);return value}overrideValues(replacements){assert(typeof replacements==="object"\x2C"Replacements must be a dictionary object.");assert(this.data_\x2C"Data must exist before being overridden");for(const key in replacements){this.data_[key]=replacements[key]}}resetForTesting(newData=null){this.data_=newData}isInitialized(){return this.data_!==null}}export const loadTimeData=new LoadTimeData;
